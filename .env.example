# ---------------------------------------------------------------------------
# SECURITY: the defaults below are LOCAL-DEV-ONLY.
# Before exposing this stack beyond localhost:
#   1. Rotate POSTGRES_PASSWORD and NEO4J_PASSWORD to random values.
#   2. Confirm docker-compose.yml port bindings are still 127.0.0.1: (default).
#   3. Set CORS_ALLOWED_ORIGINS to the real dashboard origin (no wildcards).
# See docs/security-audit.md.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://papertrail:papertrail@postgres:5432/papertrail
POSTGRES_USER=papertrail
POSTGRES_PASSWORD=papertrail
POSTGRES_DB=papertrail

# Redis
REDIS_URL=redis://redis:6379/0

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=papertrail123

# SEC EDGAR
EDGAR_USER_AGENT=PaperTrail research@papertrail.dev

# LLM (local via Ollama)
OLLAMA_URL=http://ollama:11434
# Smaller default for CPU/low RAM; pull after changing: docker compose exec ollama ollama pull tinyllama
OLLAMA_MODEL=tinyllama

# Checker agent (contradiction-checker service): LangChain tool calling needs a
# tool-capable model; tinyllama is not one. Run Ollama natively on the host for
# GPU speed (`ollama pull qwen3:4b`); the service reaches it at host.docker.internal.
CHECKER_ENABLED=true
CHECKER_MODEL=qwen3:4b
# CHECKER_OLLAMA_URL=http://host.docker.internal:11434
# CHECKER_MAX_TOOL_CALLS=3
# CHECKER_THINK=false        # qwen3 only: "true"/"false" forces thinking on/off

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
# For Docker/local development with the FastAPI backend:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# For Vercel (standalone demo with mock data), leave these empty:
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_WS_URL=
